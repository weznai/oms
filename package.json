{
  "name": "oss-ops-platform",
  "version": "1.0.0",
  "description": "运营管理平台 - 系统管理模块 (OSS Ops Platform)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "server:once": "tsx server/index.ts",
    "dev:full": "concurrently -k -n server,web -c blue,green \"npm run server\" \"npm run dev\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "db:init": "tsx scripts/init-db.ts",
    "db:sync": "tsx scripts/sync-mysql-to-sqlite.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart oss-ops",
    "pm2:stop": "pm2 stop oss-ops",
    "pm2:logs": "pm2 logs oss-ops",
    "restart": "npm run build && pm2 restart oss-ops"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.10.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "concurrently": "^8.2.2",
    "element-plus": "^2.7.6",
    "sass": "^1.77.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-vue-components": "^0.27.2",
    "vite": "^5.3.3",
    "vue-tsc": "^2.0.26"
  }
}
