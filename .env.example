# ============ 运营管理平台 环境变量配置 ============
# 复制本文件为 .env 并修改对应值

# 服务端口
PORT=1100

# CORS 允许来源（多个用逗号分隔）
CORS_ORIGIN=http://localhost:5174

# JWT 密钥（生产环境务必修改）
JWT_SECRET=oms-ops-change-this-secret-in-production

# 初始管理员账号
ADMIN_USERNAME=admin
# 初始管理员密码（明文，首次启动会写入数据库并加密，之后请通过接口修改）
ADMIN_PASSWORD=admin123

# ---------- 数据库配置 ----------
# 数据库类型: sqlite | mysql （sqlite 为默认/优先）
DB_TYPE=sqlite

# SQLite 配置
DB_SQLITE_PATH=./db/oms-ops.db

# MySQL 配置（DB_TYPE=mysql 时启用）
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USER=root
DB_MYSQL_PASSWORD=
DB_MYSQL_DATABASE=oms_ops
DB_MYSQL_CONNECTION_LIMIT=10

# ---------- 系统更新配置 ----------
# 默认 GitHub 仓库地址
UPDATE_GITHUB_URL=
# 默认分支
UPDATE_GITHUB_BRANCH=main
# GitHub Token（私有仓库需要）
UPDATE_GITHUB_TOKEN=
# PM2 应用名称
UPDATE_PM2_APP_NAME=oms-ops
# 项目根目录（留空则使用进程工作目录）
UPDATE_PROJECT_ROOT=
# 部署包保留份数
UPDATE_PACKAGE_KEEP=3
